{
  "name": "monobrowser",
  "version": "0.5.0",
  "productName": "MonoBrowser",
  "description": "Electron Browser MVP",
  "main": "dist/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "gen:icon": "node scripts/generate-icon.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/app.ts src/renderer/find.ts src/renderer/palette.ts src/renderer/notes.ts --bundle --platform=browser --format=iife --outdir=dist/renderer",
    "copy:html": "node scripts/copy-renderer-html.mjs",
    "build": "npm run clean && npm run gen:icon && npm run build:main && npm run build:renderer && npm run copy:html",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:all": "npm run build && electron-builder --win nsis --linux AppImage --x64"
  },
  "build": {
    "appId": "com.zlf.monobrowser",
    "electronUpdaterCompatibility": ">=2.16",
    "electronFuses": {
      "runAsNode": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "4tmwz7",
        "repo": "monobrowser",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
