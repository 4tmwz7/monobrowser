{
  "name": "monobrowser",
  "version": "0.3.1",
  "productName": "MonoBrowser",
  "description": "Electron Browser MVP",
  "main": "dist/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "gen:icon": "node scripts/generate-icon.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/app.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/app.js",
    "copy:html": "node scripts/copy-renderer-html.mjs",
    "build": "npm run clean && npm run gen:icon && npm run build:main && npm run build:renderer && npm run copy:html",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.zlf.monobrowser",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "4tmwz7",
        "repo": "monobrowser"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
